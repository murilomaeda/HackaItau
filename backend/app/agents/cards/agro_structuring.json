{
  "agent_id": "agro_structuring",
  "name": "Agro Structuring Agent",
  "version": "0.1.0",
  "description": "Monta duas ou três formas de fazer a operação com produtos do catálogo: valor, prazo, carência, amortização, garantias e condições. Trabalha só com o resumo de risco, sem ver balanço nem documentos do cliente, e não diz qual alternativa é melhor.",
  "capabilities": ["agro_credit_structuring"],
  "tools": ["get_product_catalog", "search_policy"],
  "allowed_data_domains": ["product_catalog", "knowledge"],
  "required_data": [
    { "tool": "get_product_catalog", "params_from": { "purpose": "task.inputs.purpose", "crop": "task.inputs.crop" } },
    { "tool": "search_policy", "params": { "query": "garantias condicionantes custeio", "top_k": 3 } }
  ],
  "depends_on": ["agro_eligibility", "agro_credit_risk"],
  "forbidden_actions": [
    "approve_credit",
    "reject_credit",
    "rank_alternatives",
    "mark_preferred_alternative",
    "read_client_financials",
    "recompute_metrics"
  ],
  "output_schema": "StructuringOutput",
  "playbook_path": "agents/structuring/playbook.md"
}
